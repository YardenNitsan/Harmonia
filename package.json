{
  "name": "harmonia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "node scripts/prepare-runtime.mjs",
    "prebuild": "node scripts/prepare-runtime.mjs",
    "dev": "vite --config apps/desktop/vite.config.ts",
    "build": "npm run typecheck && vite build --config apps/desktop/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "preview": "vite preview --config apps/desktop/vite.config.ts --host 127.0.0.1 --port 1425 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps/desktop/src packages tests",
    "format": "prettier --write apps packages tests scripts *.json *.ts *.js docs AGENTS.md",
    "format:check": "prettier --check apps packages tests scripts *.json *.ts *.js docs AGENTS.md",
    "desktop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-harmonia.ps1",
    "desktop:dev": "tauri dev --config apps/desktop/src-tauri/tauri.conf.json",
    "desktop:setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-harmonia.ps1 -SetupOnly",
    "desktop:check": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-harmonia.ps1 -CheckOnly",
    "test:startup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/startup.test.ps1",
    "desktop:build": "tauri build --config apps/desktop/src-tauri/tauri.conf.json"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^1.47.0",
    "onnxruntime-web": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
