{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Harmonia main window with no shell or filesystem capabilities.",
  "webviews": ["main"],
  "permissions": [
    "allow-list-saved-tracks",
    "allow-save-track",
    "allow-delete-track",
    "allow-capture-sources",
    "allow-capture-start",
    "allow-capture-read",
    "allow-capture-stop",
    "allow-youtube-search",
    "allow-search-cancel",
    "allow-search-status",
    "allow-audio-acquire",
    "allow-audio-read",
    "allow-audio-cancel",
    "allow-audio-reject",
    "allow-audio-diagnostics"
  ]
}
