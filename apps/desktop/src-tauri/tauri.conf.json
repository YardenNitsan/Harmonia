{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harmonia",
  "version": "0.1.0",
  "identifier": "local.harmonia.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1425",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "capabilities": ["desktop"],
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' ipc: http://ipc.localhost https://commons.wikimedia.org https://upload.wikimedia.org",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data: https://upload.wikimedia.org https://i.ytimg.com",
        "media-src": "'self' blob: asset: http://asset.localhost",
        "script-src": "'self' 'wasm-unsafe-eval' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self' blob:"
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "Harmonia",
        "width": 1440,
        "height": 960,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "category": "Music",
    "shortDescription": "Local-first chord analysis",
    "longDescription": "Analyze local music and practice with a structured chord timeline.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
